{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking command against CLAUDE.md failure modes"
          }
        ]
      }
    ]
  }
}
