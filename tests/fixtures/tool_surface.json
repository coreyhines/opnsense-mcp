  "mk_dhcp_host": {
    "description": "Create a DHCP host reservation in the dnsmasq host table (Services \u2192 DHCPv4 \u2192 Hosts). Requires hostname and MAC; at least one of ipv4 or ipv6 suffix must be provided. Optional client_id (DUID) improves stateful DHCPv6 matching when MAC alone is insufficient \u2014 copy from the dhcp tool v6 lease client_id. Defaults to a dry run; pass apply=true to write and reconfigure dnsmasq.",
    "inputSchema": {
      "anyOf": [
        {
          "required": [
            "ipv4"
          ]
        },
        {
          "required": [
            "ipv6"
          ]
        }
      ],
      "properties": {
        "apply": {
          "description": "Apply the change. Omit/false = dry run.",
          "type": "boolean"
        },
        "client_id": {
          "description": "Optional DHCP client identifier / DUID for IPv6 (e.g. '00:03:00:01:52:54:00:ab:cd:01'). Accepts optional 'id:' prefix.",
          "type": "string"
        },
        "descr": {
          "description": "Optional description",
          "type": "string"
        },
        "domain": {
          "description": "Optional domain for the host (e.g. 'lan')",
          "type": "string"
        },
        "hostname": {
          "description": "Hostname for the reservation (e.g. 'mydevice')",
          "type": "string"
        },
        "ipv4": {
          "description": "IPv4 address to assign (e.g. '10.0.8.50')",
          "type": "string"
        },
        "ipv6": {
          "description": "IPv6 suffix: integer (e.g. 50 \u2192 ::50) or '::abcd'",
          "type": [
            "integer",
            "string"
          ]
        },
        "mac": {
          "description": "MAC address (e.g. 'aa:bb:cc:dd:ee:ff')",
          "type": "string"
        }
      },
      "required": [
        "hostname",
        "mac"
      ],
      "type": "object"
    }
  },
  "mkdns": {
    "description": "Add a DNS host override in Unbound",
    "inputSchema": {
      "properties": {
        "description": {
          "description": "Optional description",
          "optional": true,
