# Copy to $OPNSENSE_MCP_INSTALL_ROOT/environment (default /opt/containerdata/opnsense-mcp/environment).
# chmod 600. Quadlet sets OPNSENSE_MCP_INSTALL_ROOT and EnvironmentFile to this path; data dir is volume-mounted.
#
# With TLS (Caddy + /opt/certs/wild), MCP clients use (default hostname in caddyfile.example):
#   https://mcp.example.com/sse

OPNSENSE_MCP_INSTALL_ROOT=/opt/containerdata/opnsense-mcp

# Pinned container images (installer writes these; do not use :latest).
# A registry, or localhost/opnsense-mcp for an image built with --build-local.
OPNSENSE_MCP_IMAGE_REPO=localhost/opnsense-mcp
# Release: 1.0.0 (git tag v1.0.0). Main CI: 1.0.0-dev.<short-sha>
OPNSENSE_MCP_IMAGE_TAG=1.0.0
OPNSENSE_MCP_CADDY_IMAGE=docker.io/library/caddy:2.9.1-alpine

OPNSENSE_FIREWALL_HOST=firewall.example.com
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
# OPNSENSE_SSL_VERIFY=false
# OPNSENSE_SSH_HOST=
# OPNSENSE_SSH_USER=root
# OPNSENSE_SSH_KEY=/path/in/container          # PRIVATE key path (not .pub)
# OPNSENSE_SSH_PORT=22
# OPNSENSE_SSH_TIMEOUT=15
# OPNSENSE_SSH_ADDRESS_FAMILY=inet             # inet (IPv4), inet6, or any
#
# The SSH tools need both a private key and a known_hosts entry in the
# directory mounted at /root/.ssh. A normal `ssh user@firewall` records the
# hostname only, which is what the host-key check looks for.

# Where config_backup action=download writes. The quadlet already sets this to
# <INSTALL_ROOT>/backups, which is the only writable mount; uncomment to point
# it elsewhere. Keep it outside the git checkout.
# OPNSENSE_BACKUP_DIR=/opt/containerdata/opnsense-mcp/backups

MCP_SECRET_KEY=change-me-long-random
# LOG_LEVEL=INFO
